            stepText.TextColor3 = Color3.fromRGB(0, 255, 150)
            timerText.Text = "100%  |  done"
            barFill.BackgroundColor3 = Color3.fromRGB(0, 255, 150)
            task.wait(0.7)
            pcall(onComplete)
        else
            if onCancel then pcall(onCancel) end
        end

        if panel and panel.Parent then panel:Destroy() end
        activePanels = math.max(0, activePanels - 1)
    end)

    return true
