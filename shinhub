local SUFFIXES = {
    {1e33, "dc"}, {1e30, "no"}, {1e27, "oc"}, {1e24, "sp"},
    {1e21, "sx"}, {1e18, "qi"}, {1e15, "qa"}, {1e12, "t"},
    {1e9,  "b"},  {1e6,  "m"},  {1e3,  "k"},
}

local SUFFIX_VALUES = {
    K = 1e3, M = 1e6, B = 1e9, T = 1e12,
    Q = 1e15, QA = 1e15, QI = 1e18, SX = 1e21, SP = 1e24,
    OC = 1e27, NO = 1e30, DC = 1e33,
}

local function formatNumber(n)
    n = tonumber(n) or 0
    if n < 1000 then return tostring(math.floor(n)) end
    for _, pair in ipairs(SUFFIXES) do
        if n >= pair[1] then
            return string.format("%.2f%s", n / pair[1], pair[2])
        end
    end
    return tostring(math.floor(n))
end

local function formatLuck(n)
    return "x" .. formatNumber(n)
end

local function parseFormattedNumber(str)
    if type(str) ~= "string" then return 0 end
    str = str:gsub("[%s,]", "")
    str = str:gsub("^[xX]", "")
    if str == "" then return 0 end

    local numStr, suffix = str:match("^([%d%.]+)([A-Za-z]*)$")
    if not numStr then return 0 end

    local num = tonumber(numStr)
    if not num then return 0 end

    if suffix and suffix ~= "" then
        local mult = SUFFIX_VALUES[suffix:upper()]
        if mult then return num * mult end
    end
    return num
end

local function parseUserAmount(str)
    str = tostring(str):upper():gsub("[%s,]", "")
    if str == "" then return nil end
    local numStr, suffix = str:match("^([%d%.]+)([A-Z]*)$")
    if not numStr then return nil end
    local num = tonumber(numStr)
    if not num or num <= 0 then return nil end
    local MULT = {
        K = 1e3, M = 1e6, B = 1e9, T = 1e12,
        Q = 1e15, QI = 1e18, SX = 1e21, SP = 1e24,
        OC = 1e27, NO = 1e30, DC = 1e33,
    }
    if suffix ~= "" then
        local m = MULT[suffix]
        if not m then return nil end
        num = num * m
    end
    return num
end

local fakeValue       = 0
local displayedValue  = 0
local initialValue    = 0
local initialized     = false
local tickAccumulator = 0

local function findLabel()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    local root = pg:FindFirstChild("Root");    if not root then return nil end
    local hud  = root:FindFirstChild("HUD");   if not hud  then return nil end
    local buff = hud:FindFirstChild("BuffBar");if not buff then return nil end
    local luck = buff:FindFirstChild("Luck");  if not luck then return nil end
    return luck:FindFirstChild("TextLabel")
end

local label = findLabel()
local suppressWrite = false

local function applyFakeText()
    if not label or not label.Parent then return end
    suppressWrite = true
    pcall(function() label.Text = formatLuck(displayedValue) end)
    suppressWrite = false
end

local function hookLabel(lbl)
    if not lbl then return end
    lbl:GetPropertyChangedSignal("Text"):Connect(function()
        if suppressWrite then return end
        task.defer(applyFakeText)
    end)
end

local function initializeFromLabel()
    if initialized then return end
    if not label or not label.Parent then return end

    local currentText = label.Text or ""
    local value = parseFormattedNumber(currentText)
    if value <= 0 then value = 0 end

    initialValue   = value
    fakeValue      = value
    displayedValue = value
    initialized    = true

    hookLabel(label)
    applyFakeText()
end

if label and label.Parent then
    initializeFromLabel()
end

task.spawn(function()
    for _ = 1, 240 do
        if initialized and label and label.Parent then return end
        task.wait(0.5)
        label = findLabel()
        if not initialized and label and label.Parent then
            initializeFromLabel()
        end
    end
end)

