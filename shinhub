local function makeBoostButton(text, yPos, color, amount)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 32)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = color
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.AutoButtonColor = false
    btn.Parent = main
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local orig = color
    local hover = Color3.new(
        math.min(orig.R + 0.12, 1),
        math.min(orig.G + 0.12, 1),
        math.min(orig.B + 0.12, 1))
    local busyColor = Color3.fromRGB(55, 55, 65)

    local busy = false

    btn.MouseEnter:Connect(function()
        if busy then return end
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = hover}):Play()
    end)
    btn.MouseLeave:Connect(function()
        if busy then return end
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = orig}):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        if busy then return end
        busy = true
        btn.BackgroundColor3 = busyColor

        local started = runInjectionCountdown(
            text, amount,
            function()
                fakeValue = fakeValue + amount
                busy = false
                btn.BackgroundColor3 = orig
                btn.Text = text
            end,
            function(elapsed, total)
                local remaining = math.max(0, math.ceil(total - elapsed))
                btn.Text = text .. "  (" .. remaining .. "s)"
            end,
            function()
                busy = false
                btn.BackgroundColor3 = orig
                btn.Text = text
            end
        )

        if not started then
            busy = false
            btn.BackgroundColor3 = orig
            btn.Text = text
        end
    end)

    return btn
end

