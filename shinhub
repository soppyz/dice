    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(0, 220, 130)
    barFill.BorderSizePixel = 0
    barFill.Parent = barBg
    Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

    local timerText = Instance.new("TextLabel")
    timerText.Size = UDim2.new(1, -100, 0, 18)
    timerText.Position = UDim2.new(0, 10, 0, 82)
    timerText.BackgroundTransparency = 1
    timerText.Text = "0%  |   " .. COUNTDOWN_TIME .. "s remaining"
    timerText.TextColor3 = Color3.fromRGB(180, 200, 220)
    timerText.Font = Enum.Font.Code
    timerText.TextSize = 11
    timerText.TextXAlignment = Enum.TextXAlignment.Left
    timerText.Parent = panel

    local cancelBtn = Instance.new("TextButton")
    cancelBtn.Size = UDim2.new(0, 80, 0, 22)
    cancelBtn.Position = UDim2.new(1, -90, 1, -30)
    cancelBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
    cancelBtn.BorderSizePixel = 0
    cancelBtn.Text = "CANCEL"
    cancelBtn.TextColor3 = Color3.fromRGB(255, 220, 220)
    cancelBtn.Font = Enum.Font.GothamBold
    cancelBtn.TextSize = 11
    cancelBtn.AutoButtonColor = true
    cancelBtn.Parent = panel
    Instance.new("UICorner", cancelBtn).CornerRadius = UDim.new(0, 5)

    local cancelled = false
    cancelBtn.MouseButton1Click:Connect(function() cancelled = true end)

    task.spawn(function()
        local startTime = os.clock()
        while not cancelled do
            if not panel.Parent then cancelled = true; break end

            local elapsed   = os.clock() - startTime
            local progress  = math.min(1, elapsed / COUNTDOWN_TIME)
            local remaining = math.max(0, COUNTDOWN_TIME - elapsed)

            barFill.Size   = UDim2.new(progress, 0, 1, 0)
            stepText.Text  = getStepForProgress(progress)
            timerText.Text = string.format("%d%%  |  %.0fs remaining",
                math.floor(progress * 100), remaining)

            if onUpdate then pcall(onUpdate, elapsed, COUNTDOWN_TIME) end

            if progress >= 1 then break end
            task.wait(0.1)
        end

