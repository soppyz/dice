RunService.Heartbeat:Connect(function(dt)
    if not initialized then return end
    if displayedValue == fakeValue then return end

    local magnitude = math.max(fakeValue, displayedValue, 1)
    local diff      = math.abs(fakeValue - displayedValue)
    local speedStep = math.max(MIN_STEP, math.floor(magnitude * ANIMATION_FACTOR))
    local step      = math.max(1, math.min(speedStep, math.ceil(diff / 30)))

    tickAccumulator = tickAccumulator + dt

    local safety = 0
    while tickAccumulator >= 0.016 and displayedValue ~= fakeValue and safety < 500 do
        tickAccumulator = tickAccumulator - 0.016
        safety = safety + 1

        if fakeValue > displayedValue then
            displayedValue = math.min(displayedValue + step, fakeValue)
        else
            displayedValue = math.max(displayedValue - step, fakeValue)
        end

        applyFakeText()
    end
end)

